# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/quizmania

# Socket.IO (client reads this at build time)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# --- Backtracking Arena (Level 2) -------------------------------------------

# Identity for the arena. The main SCIS Connect project issues the JWT; this
# service only verifies it. Leave AUTH_JWT_SECRET empty and ALLOW_DEV_AUTH=true
# to run without that project wired in yet.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=
ALLOW_DEV_AUTH=true

# Comma-separated user ids treated as contest admins.
ADMIN_USER_IDS=dev-admin

# Judge
JUDGE_CONCURRENCY=3
JUDGE_SUBMIT_COOLDOWN_MS=5000
JUDGE_WORKDIR=/tmp/arena-judge
